# Trip Nepal — Environment Variables
# Copy this file to .env (without .example) and fill in real values
# .env should NEVER be committed to Git

# ─── Supabase ────────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc......

# ─── Google Maps ─────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → Credentials
# Enable: Maps SDK for Android, Maps SDK for iOS, Places API, Directions API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza......

# ─── Anthropic (for AI Sherpa, used in Edge Functions only) ──────────
# Get from: https://console.anthropic.com
# This is used SERVER-SIDE in Supabase Edge Functions, not in app
ANTHROPIC_API_KEY=sk-ant-......

# ─── Payment Gateways (Nepal) ────────────────────────────────────────
# eSewa: https://esewa.com.np/#/merchant
# Khalti: https://khalti.com/join/merchant/
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# ─── Currency Conversion ─────────────────────────────────────────────
# Free tier: https://www.exchangerate-api.com (or https://openexchangerates.org)
EXCHANGE_RATE_API_KEY=
